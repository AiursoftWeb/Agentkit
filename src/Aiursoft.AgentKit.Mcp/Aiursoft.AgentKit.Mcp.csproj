<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Version>10.0.3</Version>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.AgentKit.Mcp</AssemblyName>
    <RootNamespace>Aiursoft.AgentKit.Mcp</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Company>Aiursoft</Company>
    <Product>AgentKit.Mcp</Product>
    <Authors>Aiursoft</Authors>
    <Description>Official MCP SDK adapters for Aiursoft.AgentKit.</Description>
    <PackageId>Aiursoft.AgentKit.Mcp</PackageId>
    <PackageTags>agents;mcp;tools;orchestration</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AiursoftWeb/agentkit</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/AiursoftWeb/agentkit.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aiursoft.AgentKit\Aiursoft.AgentKit.csproj" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="." />
    <None Include="LICENSE" Pack="true" PackagePath="." />
  </ItemGroup>
</Project>
